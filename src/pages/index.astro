---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });

// ----- placeholder data: replace with real content -----
const papers = [
  {
    title: "Paper title goes here",
    venue: "Venue 2026",
    authors: "Kartik Sharma, Coauthor One, Coauthor Two",
    summary: "One-line plain-English summary of what this paper actually shows.",
    links: [{ label: "arXiv", href: "#" }, { label: "code", href: "#" }],
    tag: "paper",
  },
  {
    title: "Another paper title here",
    venue: "Venue 2025",
    authors: "Coauthor One, Kartik Sharma, Coauthor Two",
    summary: "One-line plain-English summary of what this paper actually shows.",
    links: [{ label: "arXiv", href: "#" }],
    tag: "draft",
  },
];

const projects = [
  { name: "project one", blurb: "what it is, in a few words", href: "#", tag: "01" },
  { name: "project two", blurb: "what it is, in a few words", href: "#", tag: "02" },
  { name: "project three", blurb: "what it is, in a few words", href: "#", tag: "03" },
];
---

<Base title="Kartik Sharma">
  <!-- hero -->
  <section class="hero">
    <div class="hero-text">
      <h1>Kartik Sharma</h1>
      <p class="tagline">PhD student · UCLA</p>
      <p class="links">
        <a href={`${base}blog/`}><i class="fa-solid fa-blog" aria-hidden="true"></i><span>blog</span></a>
        <span>·</span>
        <a href="#papers"><i class="fa-regular fa-file-lines" aria-hidden="true"></i><span>papers</span></a>
        <span>·</span>
        <a href="#projects"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i><span>projects</span></a>
        <span>·</span>
        <a href="#"><i class="fa-regular fa-address-card" aria-hidden="true"></i><span>cv</span></a>
        <span>·</span>
        <a href="mailto:kartiksharma@g.ucla.edu"><i class="fa-regular fa-envelope" aria-hidden="true"></i><span>email</span></a>
        <span>·</span>
        <a href="https://github.com/skartik04"><i class="fa-brands fa-github" aria-hidden="true"></i><span>github</span></a>
        <span>·</span>
        <a href="https://scholar.google.com/citations?user=AZ0XFh4AAAAJ&hl=en"><i class="ai ai-google-scholar" aria-hidden="true"></i><span>scholar</span></a>
      </p>
      <p class="intro">
        Three-to-four lines about what you work on and why it matters, warm but
        tight. What questions keep you up at night, what you're building right
        now, and one human touch so it doesn't read like a grant abstract.
      </p>
    </div>
    <div class="hero-photo">
      <div class="portrait" aria-hidden="true">KS</div>
    </div>
  </section>

  <!-- blogs -->
  <section class="section">
    <h2>Blogs</h2>
    {posts.map((post) => (
      <article class="post-row">
        <div class="post-line">
          <a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
          <span class="date">{fmt(post.data.date)}</span>
        </div>
        <p class="teaser">{post.data.description}</p>
      </article>
    ))}
    <a class="more" href={`${base}blog/`}>all posts →</a>
  </section>

  <!-- papers -->
  <section class="section" id="papers">
    <h2>Selected Papers</h2>
    <div class="pub-list">
      {papers.map((p) => (
        <article class="pub-item">
          <div class="thumb" aria-hidden="true">
            <span>{p.tag}</span>
          </div>
          <div>
            <p class="pub-title">{p.title}</p>
            <p class="pub-venue">{p.venue}</p>
            <p class="pub-authors">{p.authors}</p>
            <p class="pub-summary">{p.summary}</p>
            <p class="pub-links">
              {p.links.map((l) => (
                <a href={l.href}>{l.label}</a>
              ))}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- projects -->
  <section class="section" id="projects">
    <h2>Projects</h2>
    <div class="projects">
      {projects.map((p) => (
        <a class="project-card" href={p.href}>
          <span class="project-img" aria-hidden="true">{p.tag}</span>
          <span class="project-name">{p.name}</span>
          <span class="project-blurb">{p.blurb}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- reviewing -->
  <section class="section reviewing" id="reviewing">
    <h2>Reviewing</h2>
    <p class="reviewing-line">ICML '26</p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 2.1fr 0.9fr;
    gap: 22px;
    align-items: center;
    margin-bottom: 32px;
  }
  h1 { font-size: 2.1rem; }
  .tagline { margin: 4px 0 8px; font-size: 1.05rem; color: var(--text-soft); }
  .links { margin: 0 0 12px; display: flex; gap: 7px; flex-wrap: wrap; color: var(--text-faint); }
  .links a { display: inline-flex; align-items: baseline; gap: 5px; font-weight: 600; }
  .links i { width: 1.05em; text-align: center; font-size: 0.92em; }
  .links .ai { font-size: 1em; }
  .intro { margin: 0; max-width: 36rem; }
  .hero-photo { justify-self: center; }
  .portrait {
    width: 200px; height: 200px;
    background: var(--thumb);
    border: 1px solid var(--border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    font-family: "Work Sans", "Inter", system-ui, sans-serif;
    font-size: 3.4rem;
    font-weight: 600;
    letter-spacing: 0;
    box-shadow: inset 0 0 0 18px var(--bg-card);
  }

  .post-row { padding: 10px 0; border-bottom: 1px solid var(--border); }
  .post-row:last-of-type { border-bottom: none; }
  .post-line { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .post-line a { font-weight: 600; font-size: 1.05rem; }
  .date { color: var(--text-faint); font-size: 0.85rem; white-space: nowrap; }
  .teaser { margin: 2px 0 0; color: var(--text-soft); font-size: 0.95rem; }
  .more { display: inline-block; margin-top: 10px; font-weight: 500; font-size: 0.95rem; }

  .pub-list { display: grid; gap: 18px; }
  .pub-item { display: grid; grid-template-columns: 96px 1fr; gap: 16px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }
  .pub-item:last-child { border-bottom: none; padding-bottom: 0; }
  .thumb {
    min-height: 68px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background:
      linear-gradient(var(--thumb-line), var(--thumb-line)) 14px 20px / 52px 5px no-repeat,
      linear-gradient(var(--thumb-line), var(--thumb-line)) 14px 32px / 66px 4px no-repeat,
      linear-gradient(var(--thumb-line), var(--thumb-line)) 14px 43px / 44px 4px no-repeat,
      var(--thumb);
    color: var(--text-soft);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 8px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .pub-title { margin: 0 0 2px; font-weight: 600; font-size: 1.1rem; }
  .pub-venue { margin: 0 0 2px; color: var(--text-soft); font-size: 0.92rem; }
  .pub-authors { margin: 0 0 4px; color: var(--text-soft); font-size: 0.92rem; }
  .pub-summary { margin: 0 0 6px; color: var(--text-soft); font-size: 0.95rem; }
  .pub-links { margin: 0; display: flex; gap: 12px; }
  .pub-links a { font-weight: 500; font-size: 0.92rem; }

  .projects { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .project-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-card);
    padding: 10px;
    color: inherit;
    display: block;
  }
  .project-card:hover { text-decoration: none; border-color: var(--accent); }
  .project-img {
    min-height: 78px;
    border-radius: 6px;
    background:
      linear-gradient(135deg, transparent 0 62%, var(--project-mark) 62% 100%),
      var(--thumb);
    color: var(--text-soft);
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 9px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .project-name { display: block; margin-top: 8px; font-weight: 600; color: var(--link); }
  .project-blurb { display: block; margin-top: 2px; color: var(--text-soft); font-size: 0.86rem; }
  .reviewing-line { margin: 0; color: var(--text-soft); }

  @media (max-width: 720px) {
    .hero { grid-template-columns: 1fr; }
    .hero-photo { justify-self: start; }
    .portrait { width: 148px; height: 148px; font-size: 2.6rem; box-shadow: inset 0 0 0 14px var(--bg-card); }
    .pub-item { grid-template-columns: 84px 1fr; gap: 12px; }
    .projects { grid-template-columns: 1fr; }
  }
</style>
