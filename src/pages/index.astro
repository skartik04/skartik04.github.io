---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

// Drafts are visible in local dev (import.meta.env.DEV) but excluded from prod builds.
const posts = (await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });

// ----- homepage data -----
const papers = [
  {
    id: "epilepsy-care",
    title: "Teaching LLMs to Recommend and Defer in Underrepresented Epilepsy Care",
    venue: "NeurIPS 2026",
    date: "2026-06-30",
    ids: ["arXiv:2606.31036", "doi:10.48550/arXiv.2606.31036"],
    authors: [
      { name: "Shreyas Rajesh", equal: true },
      { name: "Kartik Sharma", equal: true, self: true },
      { name: "Tonmoy Monsoor" },
      { name: "Mehmet Yigit Turali" },
      { name: "Richard Idro" },
      { name: "Juliana Kayaga" },
      { name: "Robert Sebunya" },
      { name: "Tracy Tushabe Namata" },
      { name: "Jessica Nichole Pasqua" },
      { name: "Vwani Roychowdhury" },
      { name: "Rajarshi Mazumder" },
    ],
    summary:
      "We study LLM decision support for anti-seizure medication management in underrepresented epilepsy care, where systems must adapt to local prescribing practice and know when to defer. We introduce Manana, a multi-agent prompt-learning framework for site-specific prescribing corrections, and Bayesian prompt averaging, which treats learned prompt states as an ensemble to produce prescription probabilities, confidence scores, and deferral decisions for specialist review.",
    links: [
      { label: "arXiv", href: "https://arxiv.org/abs/2606.31036" },
      { label: "Code", href: "https://github.com/roychowdhuryresearch/Manana" },
      { label: "Project page", href: "https://roychowdhuryresearch.github.io/MANANA_Project_Page/" },
    ],
  },
  {
    id: "panini-dr",
    title: "PANINI-DR: Controlled Deep Research through Generative Semantic Workspaces",
    venue: "arXiv 2026",
    date: "2026-10-10",
    ids: ["arXiv:2610.15208"],
    authors: [
      { name: "M. Yigit Turali", equal: true },
      { name: "Shreyas Rajesh", equal: true },
      { name: "M. Efe Lorasdagi" },
      { name: "Chenda Duan" },
      { name: "Kartik Sharma", self: true },
      { name: "Vwani Roychowdhury" },
    ],
    summary:
      "We introduce PANINI-DR, a multi-agent deep-research harness that separates coordinating the overall investigation from researching and verifying individual subquestions. A shared workspace records subquestions, dependencies, findings, and evidence, and a verification agent checks each answer against its evidence before it is reused. With a shared LLM backbone and frozen corpora, it achieves the strongest average performance against seven deep-research harnesses on BrowseComp-Plus, FRAMES, and MoNaCo, including 73.3% on BrowseComp-Plus, 16 points above the next best.",
    links: [
      { label: "arXiv", href: "https://arxiv.org/abs/2610.15208" },
      { label: "Code", href: "https://github.com/roychowdhuryresearch/panini-dr" },
      { label: "Project page", href: "https://roychowdhuryresearch.github.io/PANINI-DR_Project_Page/" },
    ],
  },
  {
    id: "enmf",
    title: "An Exterior Method for Nonnegative Matrix Factorization",
    venue: "ICML 2026",
    date: "2026-05-19",
    ids: ["arXiv:2605.19325", "doi:10.48550/arXiv.2605.19325"],
    authors: [
      { name: "Qiujing Lu", equal: true },
      { name: "Tonmoy Monsoor", equal: true },
      { name: "Ehsan Ebrahimzadeh" },
      { name: "Kartik Sharma", self: true },
      { name: "Vwani Roychowdhury" },
    ],
    summary:
      "We propose eNMF, an exterior optimization framework for nonnegative matrix factorization that separates low-rank approximation from nonnegativity enforcement. The method starts from the optimal unconstrained factorization, rotates toward the nonnegative orthant, and then refines the solution; across real and synthetic benchmarks, it improves reconstruction error and speed over a large set of NMF baselines.",
    links: [
      { label: "OpenReview", href: "https://openreview.net/forum?id=qhG8ONjZK0" },
      { label: "Code", href: "https://github.com/roychowdhuryresearch/eNMF" },
    ],
  },
  {
    id: "seizure-classification",
    title: "Video-Based Automated Seizure Classification Using Multimodal Large Language Models",
    venue: "Annals of Clinical and Translational Neurology 2026",
    date: "2026",
    ids: ["pmid:41282935", "doi:10.1101/2025.10.07.25337538"],
    authors: [
      { name: "Lina Zhang" },
      { name: "Richard Jiang" },
      { name: "Tonmoy Monsoor" },
      { name: "Jessica N. Pasqua" },
      { name: "Colin M. McCrimmon" },
      { name: "Prateik Sinha" },
      { name: "Kartik Sharma", self: true },
      { name: "Muayad Alzuabi" },
      { name: "Victor Morales" },
      { name: "Hailey M. Miranda" },
      { name: "Chaya Manjeshwar" },
      { name: "Vwani Roychowdhury" },
      { name: "Rajarshi Mazumder" },
    ],
    summary:
      "We build an MLLM pipeline for seizure video and audio that extracts clinically relevant semiological features and classifies epileptic versus nonepileptic events. The study evaluates feature extraction against expert annotations across 90 events from 29 patients and frames the system as an interpretable video-based decision-support approach.",
    links: [
      { label: "medRxiv", href: "https://www.medrxiv.org/content/10.1101/2025.10.07.25337538" },
      { label: "PubMed", href: "https://pubmed.ncbi.nlm.nih.gov/41282935/" },
    ],
  },
  {
    id: "organoid-dynamics",
    title: "Time-Resolved Neuronal Network Dynamics Distinguish Pathological States in Organoid Models",
    venue: "ICASSP 2026",
    date: "2026-03-25",
    ids: ["doi:10.64898/2026.03.25.714227"],
    authors: [
      { name: "Colin M. McCrimmon" },
      { name: "Prateik Sinha" },
      { name: "Qing Cao" },
      { name: "Tonmoy Monsoor" },
      { name: "Kartik Sharma", self: true },
      { name: "Mehmet Yigit Turali" },
      { name: "Ranmal A. Samarasinghe" },
      { name: "Vwani Roychowdhury" },
    ],
    summary:
      "We analyze two-photon calcium imaging from human brain assembloids using time-resolved functional network features. The pipeline extracts dynamic biomarkers from neuronal activity and uses them to distinguish pathological and control organoid states, connecting biomedical signal analysis with interpretable disease-model characterization.",
    links: [
      {
        label: "IEEE Xplore",
        href: "https://ieeexplore.ieee.org/document/11461496",
      },
    ],
  },
  {
    id: "closed-form-integrals",
    title: "Closed Form Expressions for Certain Improper Integrals of Mathematical Physics",
    venue: "European Physical Journal Special Topics 2024",
    date: "2024",
    ids: ["doi:10.1140/epjs/s11734-024-01103-8"],
    authors: [
      { name: "B. Ananthanarayan" },
      { name: "Tanay Pathak" },
      { name: "Kartik Sharma", self: true },
    ],
    summary:
      "We derive closed-form expressions for families of improper integrals in mathematical physics, including Ising, box, and associated integrals. The work combines the method of brackets, Mellin-Barnes representations, conic-hull residue methods, and analytic continuation to express these integrals in terms of multivariable hypergeometric functions.",
    links: [
      { label: "EPJ ST", href: "https://doi.org/10.1140/epjs/s11734-024-01103-8" },
    ],
  },
];

const projects = [
  {
    name: "Reddit Slop",
    meta: "LLM finetuning · LoRA · Reddit",
    blurb:
      "A small LoRA fine-tuning study on how Reddit-derived content changes Llama-3.1-8B-Instruct. I trained adapters on absurdist problem/solution posts from r/fifthworldproblems and mundane slice-of-life posts from r/benignexistence, then compared them against the base model on reasoning, factuality, creativity, personality, and safety-style evaluations. The main result was content-dependent: Fifth World data improved GSM8K in the tested low-data setting, while other benchmarks often degraded or shifted the model's style.",
    links: [
      { label: "Writeup", href: "https://github.com/skartik04/reddit_slop/blob/main/reports/reddit-slop.pdf" },
      { label: "Code", href: "https://github.com/skartik04/reddit_slop" },
    ],
  },
  {
    name: "Refusal Reasoning Experiments",
    meta: "LLM safety · Refusal · Response generation",
    blurb:
      "A codebase for studying refusal behavior, reasoning traces, and response generation across open and API-backed language models. It organizes harmful and harmless prompt datasets, runs think versus no-think generation, collects residual activations, labels outputs with safety judges, and analyzes pass@k-style behavior across generated responses. The goal is to make refusal behavior easier to inspect as both a generation problem and a representation-level phenomenon.",
    links: [{ label: "Code", href: "https://github.com/skartik04/reasoning" }],
  },
];

// Structured data for search engines and AI assistants (schema.org).
const siteUrl = "https://skartik04.github.io/";
const personId = `${siteUrl}#person`;
const topic = (name: string, wiki: string) => ({ "@type": "Thing", name, sameAs: `https://en.wikipedia.org/wiki/${wiki}` });
const personLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${siteUrl}#profile`,
      url: siteUrl,
      name: "Kartik Sharma | ML PhD Student at UCLA",
      mainEntity: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "Kartik Sharma",
      givenName: "Kartik",
      familyName: "Sharma",
      alternateName: ["Kartik Sharma (UCLA)", "skartik04", "s_kartik04", "kartiksharma4"],
      description:
        "PhD student at UCLA working on large language models: post-training, reinforcement learning, and on-policy distillation for reasoning models.",
      url: siteUrl,
      image: `${siteUrl}profile.jpg`,
      email: "mailto:kartiksharma@g.ucla.edu",
      jobTitle: "PhD Student",
      affiliation: {
        "@type": "Organization",
        name: "Department of Electrical and Computer Engineering, UCLA",
        url: "https://www.ee.ucla.edu/",
        parentOrganization: { "@type": "CollegeOrUniversity", name: "University of California, Los Angeles", url: "https://www.ucla.edu/" },
      },
      memberOf: { "@type": "ResearchOrganization", name: "Roychowdhury Research Group", url: "https://www.vwaniroychowdhury.com/" },
      alumniOf: { "@type": "CollegeOrUniversity", name: "Indian Institute of Science", url: "https://iisc.ac.in/" },
      knowsAbout: [
        topic("Large language models", "Large_language_model"),
        topic("LLM post-training", "Fine-tuning_(deep_learning)"),
        topic("Reinforcement learning", "Reinforcement_learning"),
        topic("On-policy distillation", "Knowledge_distillation"),
        topic("Reasoning models", "Reasoning_language_model"),
        topic("World models", "World_model_(artificial_intelligence)"),
        topic("AI safety", "AI_safety"),
        topic("Medical AI", "Artificial_intelligence_in_healthcare"),
        topic("Nonnegative matrix factorization", "Non-negative_matrix_factorization"),
        topic("Mathematical physics", "Mathematical_physics"),
      ],
      sameAs: [
        "https://github.com/skartik04",
        "https://scholar.google.com/citations?user=AZ0XFh4AAAAJ",
        "https://orcid.org/0000-0002-3116-1734",
        "https://openreview.net/profile?id=~Kartik_Sharma5",
        "https://www.semanticscholar.org/author/2300153094",
        "https://huggingface.co/kartiksharma4",
        "https://www.alphaxiv.org/@kartik-sharma-3",
        "https://x.com/s_kartik04",
        "https://www.linkedin.com/in/kartik-sharma-88b289221",
      ],
    },
    ...papers.map((p) => ({
      "@type": "ScholarlyArticle",
      "@id": `${siteUrl}#${p.id}`,
      headline: p.title,
      name: p.title,
      abstract: p.summary,
      datePublished: p.date,
      isPartOf: { "@type": "PublicationEvent", name: p.venue },
      identifier: p.ids,
      url: p.links[0]?.href,
      sameAs: p.links.map((l) => l.href),
      author: p.authors.map((a) => (a.self ? { "@id": personId } : { "@type": "Person", name: a.name })),
    })),
    ...[...papers.flatMap((p) => p.links.filter((l) => l.label === "Code").map((l) => ({ name: p.title, href: l.href }))),
        ...projects.flatMap((p) => p.links.filter((l) => l.label === "Code").map((l) => ({ name: p.name, href: l.href })))]
      .map((c) => ({
        "@type": "SoftwareSourceCode",
        name: c.name,
        codeRepository: c.href,
        url: c.href,
        author: { "@id": personId },
      })),
  ],
};

---

<Base
  title="Kartik Sharma | ML PhD Student at UCLA · LLMs & Post-Training"
  description="PhD student at UCLA working on large language models: post-training, reinforcement learning, and on-policy distillation for reasoning models."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </Fragment>
  <!-- hero -->
  <section class="hero">
    <div class="hero-heading">
      <h1>Kartik Sharma</h1>
      <p class="tagline">ML PhD student · UCLA</p>
      <p class="links">
        <a href={`${base}blog/`} aria-label="Blogs" title="Blogs"><i class="fa-solid fa-blog" aria-hidden="true"></i></a>
        <a href="mailto:kartiksharma@g.ucla.edu" aria-label="Email" title="Email"><i class="fa-regular fa-envelope" aria-hidden="true"></i></a>
        <a href={`${base}kartik-sharma-cv.pdf`} aria-label="CV" title="CV"><i class="ai ai-cv" aria-hidden="true"></i></a>
        <a rel="me" href="https://github.com/skartik04" aria-label="GitHub" title="GitHub"><i class="fa-brands fa-github" aria-hidden="true"></i></a>
        <a rel="me" href="https://scholar.google.com/citations?user=AZ0XFh4AAAAJ&hl=en" aria-label="Google Scholar" title="Google Scholar"><i class="ai ai-google-scholar" aria-hidden="true"></i></a>
        <a rel="me" href="https://x.com/s_kartik04" aria-label="X" title="X"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i></a>
        <a rel="me" href="https://www.linkedin.com/in/kartik-sharma-88b289221" aria-label="LinkedIn" title="LinkedIn"><i class="fa-brands fa-linkedin" aria-hidden="true"></i></a>
      </p>
    </div>
    <div class="hero-photo">
      <div class="portrait">
        <img src={`${base}profile.jpg`} alt="Kartik Sharma" />
      </div>
    </div>
    <div class="intro">
        <p>
          I am a PhD student in
          <a href="https://www.ee.ucla.edu/">Electrical and Computer Engineering at UCLA</a>,
          advised by <a href="https://www.vwaniroychowdhury.com/">Prof. Vwani Roychowdhury</a>.
          I work on <strong>large language models</strong>, mainly <strong>post-training</strong> for reasoning
          models: reinforcement learning and on-policy distillation with teacher interventions.
          I am also interested in <strong>world models</strong>: the internal structures that let
          a system build useful abstractions of tasks, environments, and other agents.
        </p>
        <p>
          Before UCLA, I completed my BS-MS (Research) in
          <a href="https://physics.iisc.ac.in/">Physics at IISc</a>, working with
          <a href="https://labs.dese.iisc.ac.in/pnsil/people/">Prof. Shayan Srinivasa Garani</a>
          on quantum-enhanced Viterbi decoding. I also worked with
          <a href="https://chep.iisc.ac.in/Personnel/anant.html">Prof. B. Ananthanarayan</a>
          from the Centre for High Energy Physics on analytic methods for expressing
          Feynman integrals in computable closed forms.
        </p>
        <div class="intro-work">
          <p>
            My recent work has been more applied and method-driven:
          </p>
          <ul class="intro-pointers">
            <li>
              <strong>LLM post-training and on-policy distillation</strong>
              <span>What a privileged teacher's token-level signal actually teaches a student model (<a href={`${base}blog/does-a-privileged-teacher-teach/`}>blog post</a>).</span>
            </li>
            <li>
              <strong>LLM decision support for epilepsy care</strong>
              <span>Recommendation and deferral models for underrepresented clinical settings, where local practice and uncertainty matter.</span>
            </li>
            <li>
              <strong>Multimodal models for seizure semiology</strong>
              <span>Video/audio feature extraction for interpretable seizure classification and clinically meaningful event descriptions.</span>
            </li>
            <li>
              <strong>Time-resolved neuronal dynamics in organoid models</strong>
              <span>Network features from calcium imaging to distinguish pathological and control brain assembloid states.</span>
            </li>
            <li>
              <strong>Optimization methods for nonnegative matrix factorization</strong>
              <span>Exterior optimization methods for structured low-rank factorization under nonnegativity constraints.</span>
            </li>
          </ul>
        </div>
    </div>
  </section>

  <!-- blogs -->
  <section class="section">
    <h2><a class="section-link" href={`${base}blog/`}>Blogs</a></h2>
    {posts.map((post) => (
      <article class="post-row">
        <div class="post-line">
          <a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
          <span class="date">{fmt(post.data.date)}</span>
        </div>
        <p class="teaser">{post.data.description}</p>
      </article>
    ))}
    <a class="more" href={`${base}blog/`}>All Posts →</a>
  </section>

  <!-- papers -->
  <section class="section" id="papers">
    <h2>Selected Papers</h2>
    <div class="pub-list">
      {papers.map((p) => (
        <article class="pub-item" id={p.id}>
          <div>
            <p class="pub-title">{p.title}</p>
            <p class="pub-venue">{p.venue}</p>
            <p class="pub-authors">
              {p.authors.map((author, index) => (
                <>
                  {index > 0 && ", "}
                  {author.self ? <strong class="author-self">{author.name}</strong> : author.name}
                  {author.equal && "*"}
                </>
              ))}
            </p>
            <p class="pub-summary">{p.summary}</p>
            {p.links.length > 0 && (
              <p class="pub-links">
                {p.links.map((l) => (
                  <a href={l.href}>{l.label}</a>
                ))}
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
    <p class="equal-note">* denotes equal contribution.</p>
  </section>

  <!-- projects -->
  <section class="section" id="projects">
    <h2>Projects</h2>
    <div class="projects">
      {projects.map((p) => (
        <article class="project-card">
          <span class="project-name">{p.name}</span>
          <span class="project-meta">{p.meta}</span>
          <span class="project-blurb">{p.blurb}</span>
          <span class="project-links">
            {p.links.map((l) => (
              <a href={l.href}>{l.label}</a>
            ))}
          </span>
        </article>
      ))}
    </div>
  </section>

  <!-- reviewing -->
  <section class="section reviewing" id="reviewing">
    <h2>Reviewing</h2>
    <p class="reviewing-line">ICLR 2027</p>
    <p class="reviewing-line">Mech Interp Workshop @ ICML '26</p>
    <p class="reviewing-line">Pre-to-Post Workshop @ NeurIPS '26</p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px;
    grid-template-areas:
      "heading photo"
      "intro photo";
    column-gap: 22px;
    row-gap: 0;
    align-items: start;
    margin-bottom: 32px;
  }
  .hero-heading { grid-area: heading; }
  h1 { font-size: 2.1rem; }
  .tagline { margin: 4px 0 8px; font-size: 1.05rem; color: var(--text-soft); }
  .links { margin: 0 0 12px; display: flex; gap: 10px; flex-wrap: wrap; color: var(--text-faint); }
  .links a {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--link);
    border-radius: 50%;
    font-weight: 600;
  }
  .links a:hover { color: var(--link); background: color-mix(in srgb, var(--link) 8%, transparent); text-decoration: none; }
  .links a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .links i { width: 1.15em; text-align: center; font-size: 1.28em; }
  .links .ai { font-size: 1.2em; }
  .intro { grid-area: intro; margin: 0; max-width: 40rem; display: grid; gap: 12px; font-size: 0.95rem; line-height: 1.6; }
  .intro p { margin: 0; }
  .intro strong { color: var(--text-strong); font-weight: 800; }
  .intro-work { display: grid; gap: 7px; }
  .intro-pointers {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-soft);
    line-height: 1.55;
  }
  .intro-pointers li { padding-left: 0.15rem; }
  .intro-pointers a { font-weight: 600; }
  .intro-pointers span {
    display: block;
    margin-top: 1px;
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .hero-photo { grid-area: photo; justify-self: center; padding-top: 36px; }
  .portrait {
    width: 200px; height: 200px;
    background: var(--thumb);
    border: 1px solid var(--border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    font-family: "Work Sans", "Inter", system-ui, sans-serif;
    font-size: 3.4rem;
    font-weight: 600;
    letter-spacing: 0;
    box-shadow: inset 0 0 0 18px var(--bg-card);
    overflow: hidden;
  }
  .portrait img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .section-link { color: inherit; text-decoration: none; }
  .section-link:hover { text-decoration: underline; text-underline-offset: 4px; }

  .post-row { padding: 10px 0; border-bottom: 1px solid var(--border); }
  .post-row:last-of-type { border-bottom: none; }
  .post-line { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .post-line a { font-weight: 600; font-size: 1.05rem; }
  .date { color: var(--text-faint); font-size: 0.85rem; white-space: nowrap; }
  .teaser { margin: 2px 0 0; color: var(--text-soft); font-size: 0.95rem; }
  .more { display: inline-block; margin-top: 10px; font-weight: 500; font-size: 0.95rem; }

  .pub-list { display: grid; gap: 18px; }
  .pub-item { padding-bottom: 16px; border-bottom: 1px solid var(--border); scroll-margin-top: 24px; }
  .pub-item:last-child { border-bottom: none; padding-bottom: 0; }
  .pub-title { margin: 0 0 2px; font-weight: 600; font-size: 1.1rem; }
  .pub-venue { margin: 0 0 2px; color: var(--text-soft); font-size: 0.92rem; }
  .pub-authors { margin: 0 0 12px; color: var(--text-soft); font-size: 0.93rem; line-height: 1.55; }
  .author-self { color: var(--text); font-weight: 700; }
  .pub-summary { margin: 0 0 8px; color: var(--text-soft); font-size: 1rem; line-height: 1.55; }
  .pub-links { margin: 0; display: flex; gap: 12px; }
  .pub-links a { font-weight: 500; font-size: 0.92rem; }
  .equal-note { margin: 10px 0 0; color: var(--text-faint); font-size: 0.86rem; }

  .projects { display: grid; gap: 14px; }
  .project-card {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
    color: inherit;
    display: block;
  }
  .project-card:last-child { border-bottom: none; padding-bottom: 0; }
  .project-name { display: block; font-weight: 600; color: var(--link); }
