---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---

<Base title="Blog · Kartik Sharma">
  <a class="back" href={base}>← Kartik Sharma</a>
  <h1>Writing</h1>
  <section class="posts">
    {posts.map((post) => (
      <article class="post-row">
        <a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
        <span class="date">{fmt(post.data.date)}</span>
        <p class="teaser">{post.data.description}</p>
      </article>
    ))}
  </section>
</Base>

<style>
  .back { font-size: 0.85rem; color: var(--accent); }
  h1 { font-size: 1.6rem; margin: 0.8rem 0 1.4rem; }
  .post-row { margin-bottom: 1.3rem; }
  .post-row a { font-size: 1.05rem; }
  .post-row .date { float: right; color: var(--text-faint); font-size: 0.78rem; }
  .teaser { margin: 0.15rem 0 0; color: var(--text-soft); font-size: 0.88rem; }
</style>
