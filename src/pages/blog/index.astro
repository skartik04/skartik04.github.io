---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

// Drafts are visible in local dev but excluded from prod builds.
const posts = (await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---

<Base title="Blogs · Kartik Sharma">
  <nav class="topnav">
    <a href={base}><i class="fa" aria-hidden="true"><svg viewBox="0 0 576 512"><path d="M575.8 255.5c0 18-15 32.1-32 32.1h-32l.7 160.2c0 2.7-.2 5.4-.5 8.1V472c0 22.1-17.9 40-40 40H456c-1.1 0-2.2 0-3.3-.1c-1.4 .1-2.8 .1-4.2 .1H416 392c-22.1 0-40-17.9-40-40V448 384c0-17.7-14.3-32-32-32H256c-17.7 0-32 14.3-32 32v64 24c0 22.1-17.9 40-40 40H160 128.1c-1.5 0-3-.1-4.5-.2c-1.2 .1-2.4 .2-3.6 .2H104c-22.1 0-40-17.9-40-40V360c0-.9 0-1.9 .1-2.8V287.6H32c-18 0-32-14-32-32.1c0-9 3-17 10-24L266.4 8c7-7 15-8 22-8s15 2 21 7L564.8 231.5c8 7 12 15 11 24z"/></svg></i> Home</a>
  </nav>
  <h1>Blogs</h1>
  <section class="posts">
    {posts.map((post) => (
      <article class="post-row">
        <a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
        <span class="date">{fmt(post.data.date)}</span>
        <p class="teaser">{post.data.description}</p>
      </article>
    ))}
  </section>
</Base>

<style>
  .topnav { display: flex; gap: 18px; align-items: center; font-size: 0.9rem; font-weight: 500; }
  .topnav a i { margin-right: 5px; opacity: 0.85; }
  h1 { font-size: 1.8rem; margin: 0.8rem 0 1.6rem; }
  .post-row { margin-bottom: 1.4rem; }
  .post-row a { font-size: 1.1rem; font-weight: 600; }
  .post-row .date { float: right; color: var(--text-faint); font-size: 0.85rem; }
  .teaser { margin: 0.15rem 0 0; color: var(--text-soft); font-size: 0.95rem; }
</style>
