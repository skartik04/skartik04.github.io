---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

// Drafts are visible in local dev but excluded from prod builds.
const posts = (await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---

<Base title="Blogs · Kartik Sharma">
  <nav class="topnav">
    <a href={base}><i class="fa-solid fa-house" aria-hidden="true"></i> Home</a>
  </nav>
  <h1>Blogs</h1>
  <section class="posts">
    {posts.map((post) => (
      <article class="post-row">
        <a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
        <span class="date">{fmt(post.data.date)}</span>
        <p class="teaser">{post.data.description}</p>
      </article>
    ))}
  </section>
</Base>

<style>
  .topnav { display: flex; gap: 18px; align-items: center; font-size: 0.9rem; font-weight: 500; }
  .topnav a i { margin-right: 5px; opacity: 0.85; }
  h1 { font-size: 1.8rem; margin: 0.8rem 0 1.6rem; }
  .post-row { margin-bottom: 1.4rem; }
  .post-row a { font-size: 1.1rem; font-weight: 600; }
  .post-row .date { float: right; color: var(--text-faint); font-size: 0.85rem; }
  .teaser { margin: 0.15rem 0 0; color: var(--text-soft); font-size: 0.95rem; }
</style>
