---
import Base from "../../layouts/Base.astro";
import "katex/dist/katex.min.css";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  // Drafts are visible in local dev but excluded from prod builds.
  const posts = await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const base = import.meta.env.BASE_URL;
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });

const site = Astro.site ?? new URL("https://skartik04.github.io");
const url = new URL(`blog/${post.id}/`, site).href;
const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  image: new URL(`og/${post.id}.png`, site).href,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { "@type": "Person", "@id": new URL("#person", site).href, name: "Kartik Sharma", url: site.href },
  mainEntityOfPage: url,
  url,
};

// Citation: generated from the post's title, date, and URL so every post is citable.
const d = post.data.date;
const year = d.getUTCFullYear();
const monthAbbr = d.toLocaleDateString("en-US", { month: "short", timeZone: "UTC" }).toLowerCase();
const stop = new Set(["a", "an", "the", "on", "of", "in", "for", "to", "and", "does", "is"]);
const keyWord = (post.data.title.toLowerCase().match(/[a-z0-9]+/g) ?? []).find((w) => !stop.has(w)) ?? "post";
const bibKey = `sharma${year}${keyWord}`;
const bibtex = `@misc{${bibKey},
  author       = {Sharma, Kartik},
  title        = {${post.data.title}},
  year         = {${year}},
  month        = ${monthAbbr},
  howpublished = {\\url{${url}}},
  note         = {Blog post}
}`;
const citeDate = `${year}/${String(d.getUTCMonth() + 1).padStart(2, "0")}/${String(d.getUTCDate()).padStart(2, "0")}`;
const monthYear = d.toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
---

<Base
  title={post.data.title.length > 54 ? post.data.title : `${post.data.title} · Kartik Sharma`}
  description={post.data.description}
  image={`og/${post.id}.png`}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
    <meta name="citation_title" content={post.data.title} />
    <meta name="citation_author" content="Sharma, Kartik" />
    <meta name="citation_publication_date" content={citeDate} />
    <meta name="citation_online_date" content={citeDate} />
    <meta name="citation_public_url" content={url} />
    <meta name="citation_abstract" content={post.data.description} />
    <meta name="DC.title" content={post.data.title} />
    <meta name="DC.creator" content="Sharma, Kartik" />
    <meta name="DC.date" content={d.toISOString().slice(0, 10)} />
    <meta name="DC.type" content="Text.Blog" />
  </Fragment>

  <nav class="topnav">
    <a href={base}><i class="fa" aria-hidden="true"><svg viewBox="0 0 576 512"><path d="M575.8 255.5c0 18-15 32.1-32 32.1h-32l.7 160.2c0 2.7-.2 5.4-.5 8.1V472c0 22.1-17.9 40-40 40H456c-1.1 0-2.2 0-3.3-.1c-1.4 .1-2.8 .1-4.2 .1H416 392c-22.1 0-40-17.9-40-40V448 384c0-17.7-14.3-32-32-32H256c-17.7 0-32 14.3-32 32v64 24c0 22.1-17.9 40-40 40H160 128.1c-1.5 0-3-.1-4.5-.2c-1.2 .1-2.4 .2-3.6 .2H104c-22.1 0-40-17.9-40-40V360c0-.9 0-1.9 .1-2.8V287.6H32c-18 0-32-14-32-32.1c0-9 3-17 10-24L266.4 8c7-7 15-8 22-8s15 2 21 7L564.8 231.5c8 7 12 15 11 24z"/></svg></i> Home</a>
    <a href={`${base}blog/`}><i class="fa" aria-hidden="true"><svg viewBox="0 0 512 512"><path d="M192 32c0 17.7 14.3 32 32 32c123.7 0 224 100.3 224 224c0 17.7 14.3 32 32 32s32-14.3 32-32C512 128.9 383.1 0 224 0c-17.7 0-32 14.3-32 32zm0 96c0 17.7 14.3 32 32 32c70.7 0 128 57.3 128 128c0 17.7 14.3 32 32 32s32-14.3 32-32c0-106-86-192-192-192c-17.7 0-32 14.3-32 32zM96 144c0-26.5-21.5-48-48-48S0 117.5 0 144V368c0 79.5 64.5 144 144 144s144-64.5 144-144s-64.5-144-144-144H128v96h16c26.5 0 48 21.5 48 48s-21.5 48-48 48s-48-21.5-48-48V144z"/></svg></i> Blogs</a>
  </nav>
  <h1>{post.data.title}</h1>
  <p class="date"><span>By <a href={base} rel="author">Kartik Sharma</a> · {fmt(post.data.date)}</span><a class="cite-jump" href="#citation"><i class="fa" aria-hidden="true"><svg viewBox="0 0 448 512"><path d="M0 216C0 149.7 53.7 96 120 96h8c17.7 0 32 14.3 32 32s-14.3 32-32 32h-8c-30.9 0-56 25.1-56 56v8h64c35.3 0 64 28.7 64 64v64c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V320 288 216zm256 0c0-66.3 53.7-120 120-120h8c17.7 0 32 14.3 32 32s-14.3 32-32 32h-8c-30.9 0-56 25.1-56 56v8h64c35.3 0 64 28.7 64 64v64c0 35.3-28.7 64-64 64H320c-35.3 0-64-28.7-64-64V320 288 216z"/></svg></i> Cite this post</a></p>

  {toc.length > 0 && (
    <nav class="toc" aria-label="Table of contents">
      <p class="toc-title">Contents</p>
      <ol>
        {toc.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
        <li><a href="#citation">Citation</a></li>
      </ol>
    </nav>
  )}

  <article class="prose">
    <Content />
  </article>

  <section class="cite" id="citation" aria-labelledby="citation-title">
    <h2 id="citation-title">Citation</h2>
    <p class="cite-plain">Sharma, Kartik. "{post.data.title}." Blog post, {monthYear}. <a href={url}>{url}</a></p>
    <div class="cite-bib">
      <button type="button" class="cite-copy" aria-label="Copy BibTeX">Copy</button>
      <pre><code id="cite-bibtex">{bibtex}</code></pre>
    </div>
  </section>
</Base>

<script is:inline>
  // Copy the BibTeX citation.
  const citeBtn = document.querySelector(".cite-copy");
  if (citeBtn) {
    citeBtn.addEventListener("click", async () => {
      const txt = document.getElementById("cite-bibtex").textContent;
      try { await navigator.clipboard.writeText(txt); } catch (e) {
        const r = document.createRange(); r.selectNodeContents(document.getElementById("cite-bibtex"));
        const sel = getSelection(); sel.removeAllRanges(); sel.addRange(r); document.execCommand("copy"); sel.removeAllRanges();
      }
      citeBtn.textContent = "Copied";
      setTimeout(() => (citeBtn.textContent = "Copy"), 1500);
    });
  }

  // Scrollspy: highlight the current section in the sidebar TOC.
  const tocLinks = [...document.querySelectorAll(".toc a")];
  if (tocLinks.length) {
    const map = new Map(
      tocLinks.map((a) => [decodeURIComponent(a.getAttribute("href").slice(1)), a])
    );
    const heads = [...document.querySelectorAll(".prose h2[id]")];
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            tocLinks.forEach((l) => l.classList.remove("active"));
            map.get(e.target.id)?.classList.add("active");
          }
        });
      },
      { rootMargin: "0px 0px -75% 0px", threshold: 0 }
    );
    heads.forEach((h) => obs.observe(h));
  }
</script>

<style>
  .topnav { display: flex; gap: 18px; font-size: 0.9rem; font-weight: 500; margin-bottom: 0.2rem; }
  .topnav a i { margin-right: 5px; opacity: 0.85; }
  h1 { font-size: 1.9rem; margin: 0.8rem 0 0.2rem; }
  .date { color: var(--text-faint); font-size: 0.88rem; margin: 0 0 1.6rem; }
  .date { display: flex; align-items: center; flex-wrap: wrap; gap: 0.7rem; }
  .cite-jump {
    display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.28rem 0.75rem; border-radius: 999px;
    border: 1px solid var(--accent); color: var(--accent);
    font-size: 0.82rem; font-weight: 600; text-decoration: none;
  }
  .cite-jump:hover { background: var(--accent); color: var(--bg); text-decoration: none; }
  .cite-jump i { font-size: 0.8em; }

  .cite { margin: 2.6rem 0 0.5rem; padding-top: 1.4rem; border-top: 1px solid var(--border); scroll-margin-top: 80px; }
  .cite h2 { font-size: 1.25rem; margin: 0 0 0.6rem; }
  .cite-plain { font-size: 0.92rem; color: var(--text-soft); margin: 0 0 0.9rem; overflow-wrap: anywhere; }
  .cite-bib { position: relative; }
  .cite-bib pre {
    margin: 0; padding: 0.9rem 1rem; border-radius: 8px; font-size: 0.82rem; line-height: 1.55;
    overflow-x: auto; background: var(--bg-card); border: 1px solid var(--border);
  }
  .cite-copy {
    position: absolute; top: 8px; right: 8px; font: inherit; font-size: 0.78rem; font-weight: 500;
    padding: 0.25rem 0.65rem; border-radius: 6px; border: 1px solid var(--border);
    background: var(--bg); color: var(--text-soft); cursor: pointer;
  }
  .cite-copy:hover { color: var(--accent); border-color: var(--accent); }

  .toc {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.7rem 1.1rem 0.8rem;
    margin: 0 0 2rem;
    background: var(--bg-card);
    font-size: 0.9rem;
  }
  .toc-title {
    margin: 0 0 0.35rem;
    font-weight: 650;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-faint);
  }
  .toc ol { margin: 0; padding-left: 1.15rem; }
  .toc li { margin: 0.2rem 0; }
  .toc a { color: var(--text-soft); }
  .toc a:hover { color: var(--accent); }

  /* Wide screens: lift the TOC into the left margin, fixed + scrollspy. */
  @media (min-width: 1300px) {
    .toc {
      position: fixed;
      top: 92px;
      left: calc((100vw - 860px) / 2 - 220px);
      width: 196px;
      margin: 0;
      padding: 0;
      border: none;
      border-radius: 0;
      background: none;
      max-height: calc(100vh - 140px);
      overflow-y: auto;
    }
    .toc-title { margin-bottom: 0.5rem; }
    .toc ol { padding-left: 0; list-style: none; }
    .toc li { margin: 0; }
    .toc a {
      display: block;
      padding: 0.28rem 0 0.28rem 0.7rem;
      border-left: 2px solid var(--border);
      line-height: 1.3;
      font-size: 0.8rem;
      transition: color 0.15s, border-color 0.15s;
    }
    .toc a.active {
      color: var(--accent);
      border-left-color: var(--accent);
      font-weight: 500;
    }
  }

</style>

<style is:global>
  .prose { font-size: 0.97rem; }
  .prose pre { padding: 0.9rem 1rem; border-radius: 8px; font-size: 0.85rem; overflow-x: auto; }
  .prose code { font-size: 0.88em; }
  .prose blockquote {
    margin: 1rem 0; padding: 0.1rem 1rem;
    border-left: 3px solid var(--border); color: var(--text-soft);
  }
  .prose img { max-width: 100%; height: auto; border-radius: 8px; }
  .prose figure {
    margin: 1.25rem 0 1.35rem;
  }
  .prose figure img {
    display: block;
    border: 1px solid var(--border);
    background: var(--bg-card);
  }
  .prose figcaption {
    margin-top: 0.45rem;
    color: var(--text-soft);
    font-size: 0.84rem;
    line-height: 1.45;
  }
  .prose .figure-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 1.2rem 0 1.4rem;
  }
  .prose .figure-grid figure {
    margin: 0;
  }
  .prose .figure-grid figcaption {
    font-size: 0.78rem;
  }
  @media (max-width: 720px) {
    .prose .figure-grid {
      grid-template-columns: 1fr;
    }
  }
  .prose h2 { font-size: 1.25rem; margin: 1.8rem 0 0.5rem; }
  .prose h3 { font-size: 1.05rem; margin: 1.4rem 0 0.4rem; }
  .prose table {
    width: 100%;
    max-width: 100%;
    margin: 1.15rem 0 1.35rem;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--border);
    border-radius: 7px;
    overflow: hidden;
    background: var(--bg-card);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--text) 5%, transparent);
    font-size: 0.84rem;
    line-height: 1.38;
  }
  .prose thead {
    background: color-mix(in srgb, var(--thumb) 78%, var(--bg-card));
  }
  .prose th,
  .prose td {
    padding: 0.55rem 0.72rem;
    border-right: 1px solid color-mix(in srgb, var(--border) 76%, transparent);
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  .prose th {
    color: var(--text-strong);
    font-family: "Inter", system-ui, -apple-system, sans-serif;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0;
  }
  .prose td {
    color: var(--text);
  }
  .prose th:first-child,
  .prose td:first-child {
    min-width: 7.5rem;
  }
  .prose tbody td:first-child {
    color: var(--text-strong);
    font-weight: 500;
  }
  .prose th[align="right"],
  .prose td[align="right"] {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .prose th[align="left"],
  .prose td[align="left"] {
    text-align: left;
  }
  .prose tbody tr:nth-child(even) {
    background: color-mix(in srgb, var(--thumb) 48%, transparent);
  }
  .prose tbody tr:hover {
    background: color-mix(in srgb, var(--accent) 9%, transparent);
  }
  .prose tr:last-child td { border-bottom: 0; }
  .prose th:last-child,
  .prose td:last-child { border-right: 0; }
  .prose .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.15rem 0;
  }

  @media (max-width: 720px) {
    .prose table {
      display: block;
      width: 100%;
      max-width: 100%;
      margin: 1rem 0 1.3rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      font-size: 0.8rem;
    }
    .prose table::-webkit-scrollbar { height: 8px; }
    .prose table::-webkit-scrollbar-thumb {
      background: var(--thumb-line);
      border-radius: 999px;
    }
    .prose th,
    .prose td {
      padding: 0.5rem 0.62rem;
    }
  }
</style>
