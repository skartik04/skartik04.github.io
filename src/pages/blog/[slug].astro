---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const base = import.meta.env.BASE_URL;
const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<Base title={`${post.data.title} · Kartik Sharma`} description={post.data.description}>
  <a class="back" href={`${base}blog/`}>← all posts</a>
  <h1>{post.data.title}</h1>
  <p class="date">{fmt(post.data.date)}</p>
  <article class="prose">
    <Content />
  </article>
</Base>

<style>
  .back { font-size: 0.9rem; font-weight: 500; }
  h1 { font-size: 1.9rem; margin: 0.8rem 0 0.2rem; }
  .date { color: var(--text-faint); font-size: 0.88rem; margin: 0 0 1.8rem; }
</style>

<style is:global>
  .prose { font-size: 0.97rem; }
  .prose pre { padding: 0.9rem 1rem; border-radius: 8px; font-size: 0.85rem; overflow-x: auto; }
  .prose code { font-size: 0.88em; }
  .prose blockquote {
    margin: 1rem 0; padding: 0.1rem 1rem;
    border-left: 3px solid var(--border); color: var(--text-soft);
  }
  .prose img { max-width: 100%; border-radius: 8px; }
  .prose h2 { font-size: 1.25rem; margin: 1.8rem 0 0.5rem; }
  .prose h3 { font-size: 1.05rem; margin: 1.4rem 0 0.4rem; }
</style>
