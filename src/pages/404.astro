---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---

<Base title="404 · Kartik Sharma" description="Page not found.">
  <section class="notfound">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="msg">This page does not exist, or it has moved. Let's get you back.</p>
    <p class="links">
      <a href={base}><i class="fa-solid fa-house" aria-hidden="true"></i> Home</a>
      <a href={`${base}blog/`}><i class="fa-solid fa-blog" aria-hidden="true"></i> Blogs</a>
    </p>
  </section>
</Base>

<style>
  .notfound { padding: 9vh 0 12vh; }
  .code {
    font-family: "Work Sans", "Inter", sans-serif;
    font-size: 4.2rem;
    font-weight: 700;
    color: var(--accent);
    margin: 0;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  h1 { font-size: 1.6rem; margin: 0.5rem 0 0.6rem; }
  .msg { color: var(--text-soft); margin: 0 0 1.5rem; }
  .links { display: flex; gap: 18px; font-weight: 500; }
  .links a i { margin-right: 5px; opacity: 0.85; }
</style>
