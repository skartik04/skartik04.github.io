---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
}

const {
  title,
  description = "Personal website of Kartik Sharma",
  image = "profile.jpg",
  ogType = "website",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL("https://skartik04.github.io");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Kartik Sharma" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <!-- Social share cards (Open Graph + Twitter) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Kartik Sharma" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Work+Sans:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/academicons/1.9.4/css/academicons.min.css"
      integrity="sha512-IW0nhlW5MgNydsXJO40En2EoCkTTjZhI3yuODrZIc8cQ4h1XcF53PsqDHa09NqnkXuIe0Oiyyj171BqZFwISBw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script is:inline>
      const saved = localStorage.getItem("theme");
      // Default to LIGHT mode; only go dark if the visitor explicitly chose it.
      const dark = saved === "dark";
      if (dark) document.documentElement.classList.add("dark");
    </script>
    <slot name="head" />
  </head>
  <body>
    <button class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
      <i class="fa-solid fa-sun icon-sun" aria-hidden="true"></i>
      <i class="fa-solid fa-moon icon-moon" aria-hidden="true"></i>
    </button>

    <button class="to-top" aria-label="Back to top" title="Back to top">
      <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>

    <main>
      <slot />
    </main>

    <footer>
      <span>© 2026 Kartik Sharma · Last updated {new Date().toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" })}</span>
    </footer>

    <!-- Visitor analytics: GoatCounter (cookieless, no consent banner, no personal data).
         Counts every page since this layout wraps the whole site.
         Account "kartiksharma" -> dashboard at https://kartiksharma.goatcounter.com -->
    <!-- Own visitor log: Cloudflare Worker in ../stats (city, timezone, network; no cookies, no IPs stored).
         Visiting any page with #toggle-stats turns counting off/on for this browser, for both trackers. -->
    <script is:inline>
      (() => {
        const SKIP = "kstats-skip";
        try {
          if (location.hash === "#toggle-stats") {
            const off = !localStorage.getItem(SKIP);
            if (off) { localStorage.setItem(SKIP, "1"); localStorage.setItem("skipgc", "t"); }
            else { localStorage.removeItem(SKIP); localStorage.removeItem("skipgc"); }
            history.replaceState(null, "", location.pathname + location.search);
            alert(off ? "Your visits are no longer counted on this browser." : "Counting is back on for this browser.");
          }
          if (localStorage.getItem(SKIP) || /^(localhost|127\.)/.test(location.hostname)) return;
        } catch (e) {}

        const END = "https://kartik-site.skartik04.workers.dev";
        const id = Math.random().toString(36).slice(2) + Date.now().toString(36);
        const send = (path, body) => {
          const data = JSON.stringify(body);
          if (!(navigator.sendBeacon && navigator.sendBeacon(END + path, data))) {
            fetch(END + path, { method: "POST", body: data, keepalive: true }).catch(() => {});
          }
        };
        let tz = "";
        try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone; } catch (e) {}
        send("/p", {
          id, p: location.pathname, t: document.title, r: document.referrer,
          w: screen.width, h: screen.height, tz, l: navigator.language,
        });

        // Time the page is actually visible, and how far down it was scrolled.
        let shown = document.visibilityState === "visible" ? Date.now() : 0, total = 0, scroll = 0;
        addEventListener("scroll", () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          scroll = Math.max(scroll, max > 0 ? Math.round((scrollY / max) * 100) : 100);
        }, { passive: true });

        // Section headings that came into view, in order.
        const reached = [];
        addEventListener("DOMContentLoaded", () => {
          if (!("IntersectionObserver" in window)) return;
          const io = new IntersectionObserver((entries) => entries.forEach((en) => {
            if (!en.isIntersecting) return;
            const t = en.target.textContent.trim().replace(/\s+/g, " ");
            if (t && !reached.includes(t)) reached.push(t);
            io.unobserve(en.target);
          }));
          document.querySelectorAll("main h2, main h3").forEach((h) => io.observe(h));
        });

        // Link and button clicks (not the theme / back-to-top controls), and copied text.
        document.addEventListener("click", (e) => {
          const el = e.target.closest && e.target.closest("a[href], button");
          if (!el || el.matches(".theme-toggle, .to-top")) return;
          const text = (el.textContent.trim().replace(/\s+/g, " ") || el.getAttribute("aria-label") || el.title || "").slice(0, 120);
          send("/c", { id, k: "click", v: el.href || "", x: el.tagName === "BUTTON" ? el.getAttribute("aria-label") || text : text });
        }, true);
        document.addEventListener("copy", () => {
          const t = String(getSelection()).trim();
          if (t) send("/c", { id, k: "copy", v: t.slice(0, 500) });
        });

        const flush = () => {
          if (shown) { total += Date.now() - shown; shown = 0; }
          send("/e", { id, s: Math.round(total / 1000), sc: scroll, sec: reached });
        };
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "hidden") flush();
          else shown = Date.now();
        });
        addEventListener("pagehide", flush);
      })();
    </script>
    <script data-goatcounter="https://kartiksharma.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>

    <script is:inline>
      document.querySelector(".theme-toggle").addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });

      document.querySelector(".to-top")?.addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: "smooth" })
      );
    </script>
  </body>
</html>
